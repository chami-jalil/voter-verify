<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:VoterVerification.ViewModels"
             x:Class="VoterVerification.Views.DashboardPage"
             x:DataType="viewModels:DashboardViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">
            <Label Text="{Binding SignedInAs}" Style="{StaticResource Muted}" />
            <Label Text="Voter list records are read-only. Saving a verification does not change the electoral roll."
                   Style="{StaticResource Body}" />

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" TextColor="{StaticResource Danger}" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto">
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Expected" Style="{StaticResource SectionLabel}" />
                        <Label Text="{Binding ExpectedVoters}" Style="{StaticResource StatValue}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Verified" Style="{StaticResource SectionLabel}" />
                        <Label Text="{Binding VerifiedCount}" Style="{StaticResource StatValue}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Voters on file" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding VotersOnFile}" Style="{StaticResource StatValue}" />
                    <Label Text="Expected is the configured roll size. The other counts come from Azure Table Storage."
                           Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Search voters" Command="{Binding SearchCommand}" />
            <Button Text="Refresh counts" Style="{StaticResource QuietButton}" Command="{Binding LoadCommand}" />
            <Button Text="Change ward" Style="{StaticResource QuietButton}" Command="{Binding ChangeWardCommand}" />
            <Button Text="Sign out" Style="{StaticResource QuietButton}" Command="{Binding SignOutCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
