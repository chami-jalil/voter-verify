<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:VoterVerification.ViewModels"
             x:Class="VoterVerification.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Sign in">
    <ScrollView>
        <VerticalStackLayout Padding="24,36" Spacing="16" VerticalOptions="Center">
            <Label Text="INTERNAL" Style="{StaticResource Eyebrow}" />
            <Label Text="Voter verification" Style="{StaticResource PageTitle}" />
            <Label Text="Authorized staff can look up a ward voter list and record a verification. The electoral roll itself is not changed."
                   Style="{StaticResource Body}" />

            <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding HasConfigurationProblem}">
                <Label Text="{Binding ConfigurationMessage}" Style="{StaticResource Body}" />
            </Border>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" TextColor="{StaticResource Danger}" />
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Sign in with Microsoft"
                    Command="{Binding SignInCommand}"
                    SemanticProperties.Description="Sign in with Microsoft" />

            <Label Text="Access uses your Microsoft Entra ID account. Storage keys are not stored in this app."
                   Style="{StaticResource Muted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
