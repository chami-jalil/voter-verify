<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:VoterVerification.ViewModels"
             xmlns:models="clr-namespace:VoterVerification.Models"
             x:Class="VoterVerification.Views.VoterSearchPage"
             x:DataType="viewModels:VoterSearchViewModel"
             Title="Search">
    <Grid RowDefinitions="Auto,*" Padding="20,12" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Serial number, EPIC, name, or house number. Names can be Telugu or English."
                   Style="{StaticResource Muted}" />
            <Border Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Padding="12,2">
                <Entry Text="{Binding Query}"
                       Placeholder="Search this ward"
                       ReturnCommand="{Binding SearchCommand}"
                       ClearButtonVisibility="WhileEditing"
                       SemanticProperties.Description="Search voters" />
            </Border>
            <Button Text="Search" Command="{Binding SearchCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource Body}" TextColor="{StaticResource Danger}" />
            </Border>
            <Label Text="{Binding ResultSummary}" Style="{StaticResource Muted}" IsVisible="{Binding HasResultSummary}" />
            <Label Text="{Binding EmptyMessage}" Style="{StaticResource Muted}" IsVisible="{Binding ShowEmpty}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VoterSearchHit">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" Style="{StaticResource TeluguValue}" FontSize="20" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Body}" />
                            <Label Text="{Binding MetaLine}" Style="{StaticResource Muted}" />
                            <Button Text="Open"
                                    Style="{StaticResource QuietButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:VoterSearchViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
