<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:VoterVerification.ViewModels"
             xmlns:models="clr-namespace:VoterVerification.Models"
             x:Class="VoterVerification.Views.WardSelectionPage"
             x:DataType="viewModels:WardSelectionViewModel"
             Title="Wards">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">
            <Label Text="Choose a ward" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding SignedInAs}" Style="{StaticResource Muted}" />
            <Label Text="{Binding EmptyMessage}" Style="{StaticResource Muted}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Wards}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:WardOption">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="22" />
                                <Label Text="{Binding ExpectedText}" Style="{StaticResource Body}" />
                                <Label Text="{Binding UnavailableReason}"
                                       Style="{StaticResource Muted}"
                                       IsVisible="{Binding ShowUnavailable}" />
                                <Button Text="{Binding ActionText}"
                                        IsEnabled="{Binding IsConfigured}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WardSelectionViewModel}}, Path=OpenWardCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Sign out" Style="{StaticResource QuietButton}" Command="{Binding SignOutCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
