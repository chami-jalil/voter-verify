<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>VoterVerification</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Voter Verification</ApplicationTitle>
		<ApplicationId>com.voterverification.internal</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>

		<!-- One ABI keeps the field APK smaller. Add android-arm for 32-bit devices. -->
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<!-- The Azure SDK reflects over entity properties. -->
		<PublishTrimmed>false</PublishTrimmed>
		<TrimMode>copy</TrimMode>
	</PropertyGroup>

	<!--
	  The MSAL redirect scheme is derived from AppConfiguration.ClientId so the
	  manifest and the sign-in code cannot drift. An empty client id uses a
	  placeholder scheme; sign-in stays disabled until the id is set.
	-->
	<PropertyGroup>
		<_AppConfigText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Configuration/AppConfiguration.cs'))</_AppConfigText>
		<EntraClientId>$([System.Text.RegularExpressions.Regex]::Match($(_AppConfigText), 'const string ClientId = "([^"]*)"').Groups[1].Value)</EntraClientId>
		<_MsalScheme Condition="'$(EntraClientId)' != ''">msal$(EntraClientId)</_MsalScheme>
		<_MsalScheme Condition="'$(EntraClientId)' == ''">msal00000000-0000-0000-0000-000000000000</_MsalScheme>
		<AndroidManifestPlaceholders>msalScheme=$(_MsalScheme)</AndroidManifestPlaceholders>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="tests/**" />
		<Compile Remove="tools/**" />
		<Compile Remove="api/**" />
		<Compile Remove="bin/**" />
		<Compile Remove="obj/**" />
		<None Remove="tests/**" />
		<None Remove="tools/**" />
		<None Remove="api/**" />
		<Content Remove="tools/**" />
		<Content Remove="api/**" />
		<EmbeddedResource Remove="tools/**" />
		<EmbeddedResource Remove="api/**" />
		<MauiXaml Remove="tests/**" />
		<MauiXaml Remove="tools/**" />
		<MauiXaml Remove="api/**" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F4C5C" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F4C5C" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*.ttf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
	</ItemGroup>

</Project>
