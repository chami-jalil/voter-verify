<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VoterVerification.Functions</RootNamespace>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)/Configuration/AppConfiguration.cs" Link="Linked/AppConfiguration.cs" />
    <Compile Include="$(RepoRoot)/Data/VoterTableEntity.cs" Link="Linked/VoterTableEntity.cs" />
    <Compile Include="$(RepoRoot)/Data/VoterVerificationTableEntity.cs" Link="Linked/VoterVerificationTableEntity.cs" />
    <Compile Include="$(RepoRoot)/Data/TableEntityMapper.cs" Link="Linked/TableEntityMapper.cs" />
    <Compile Include="$(RepoRoot)/Helpers/TableKeyRules.cs" Link="Linked/TableKeyRules.cs" />
    <Compile Include="$(RepoRoot)/Helpers/ODataLiteral.cs" Link="Linked/ODataLiteral.cs" />
    <Compile Include="$(RepoRoot)/Helpers/VoterLookup.cs" Link="Linked/VoterLookup.cs" />
    <Compile Include="$(RepoRoot)/Helpers/VoterTextMatch.cs" Link="Linked/VoterTextMatch.cs" />
    <Compile Include="$(RepoRoot)/Helpers/VoterQueryBuilder.cs" Link="Linked/VoterQueryBuilder.cs" />
    <Compile Include="$(RepoRoot)/Helpers/PhoneNumberRules.cs" Link="Linked/PhoneNumberRules.cs" />
    <Compile Include="$(RepoRoot)/Helpers/VerificationUpdatePolicy.cs" Link="Linked/VerificationUpdatePolicy.cs" />
    <Compile Include="$(RepoRoot)/Helpers/TenantPartitions.cs" Link="Linked/TenantPartitions.cs" />
    <Compile Include="$(RepoRoot)/Helpers/VoterPartitionSearch.cs" Link="Linked/VoterPartitionSearch.cs" />
    <Compile Include="$(RepoRoot)/Models/DashboardStats.cs" Link="Linked/DashboardStats.cs" />
    <Compile Include="$(RepoRoot)/Models/SignedInUser.cs" Link="Linked/SignedInUser.cs" />
    <Compile Include="$(RepoRoot)/Models/VerificationDraft.cs" Link="Linked/VerificationDraft.cs" />
    <Compile Include="$(RepoRoot)/Models/VerificationWritePlan.cs" Link="Linked/VerificationWritePlan.cs" />
    <Compile Include="$(RepoRoot)/Models/VoterDetails.cs" Link="Linked/VoterDetails.cs" />
    <Compile Include="$(RepoRoot)/Models/VoterRecord.cs" Link="Linked/VoterRecord.cs" />
    <Compile Include="$(RepoRoot)/Models/VoterSearchHit.cs" Link="Linked/VoterSearchHit.cs" />
    <Compile Include="$(RepoRoot)/Models/VoterSearchOutcome.cs" Link="Linked/VoterSearchOutcome.cs" />
    <Compile Include="$(RepoRoot)/Models/VoterVerificationRecord.cs" Link="Linked/VoterVerificationRecord.cs" />
    <Compile Include="$(RepoRoot)/Models/WardOption.cs" Link="Linked/WardOption.cs" />
    <Compile Include="$(RepoRoot)/Services/AppException.cs" Link="Linked/AppException.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="local.settings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
