<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>VoterVerification.Tests</RootNamespace>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)/Configuration/AppConfiguration.cs" Link="Linked/AppConfiguration.cs" />
    <Compile Include="$(RepoRoot)/Configuration/WardCatalog.cs" Link="Linked/WardCatalog.cs" />
    <Compile Include="$(RepoRoot)/Models/*.cs" Link="Linked/Models/%(Filename)%(Extension)" />
    <Compile Include="$(RepoRoot)/Helpers/*.cs" Link="Linked/Helpers/%(Filename)%(Extension)" />
    <Compile Include="$(RepoRoot)/Services/AppException.cs" Link="Linked/AppException.cs" />
    <Compile Include="$(RepoRoot)/Services/ErrorMapper.cs" Link="Linked/ErrorMapper.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)/Services/AzureTableVoterDataService.cs" Link="sources/AzureTableVoterDataService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)/Platforms/Android/AndroidManifest.xml" Link="sources/AndroidManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)/VoterVerification.csproj" Link="sources/VoterVerification.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)/Configuration/AppConfiguration.cs" Link="sources/AppConfiguration.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
